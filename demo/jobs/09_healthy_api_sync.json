{
  "name": "09_healthy_api_sync",
  "description": "API returns 200 with data; job exits 0.",
  "schedule": "hourly",
  "command": [
    "${PYTHON}",
    "${JOB_DIR}/../scripts/sync_orders.py",
    "--url",
    "${DEMO_API_URL}/api/orders?date=${RUN_DATE}&scenario=ok"
  ],
  "cwd": "${WORKSPACE}/09_healthy_api_sync",
  "timeout_seconds": 30,
  "expected_outcome": "Today's orders are available from the orders API (items is non-empty) and saved locally.",
  "checks": [
    {
      "type": "http",
      "name": "orders API has today's items",
      "url": "${DEMO_API_URL}/api/orders?date=${RUN_DATE}&scenario=ok",
      "json_field": "items",
      "op": "non_empty"
    },
    {
      "type": "file",
      "name": "orders saved",
      "path": "out/orders-${RUN_DATE}.json",
      "fresh": true,
      "json_field": "0.order_id",
      "op": "exists"
    }
  ],
  "demo": {
    "expected_verdict": "OK",
    "cause_keywords": []
  }
}
