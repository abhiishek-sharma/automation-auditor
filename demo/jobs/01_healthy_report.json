{
  "name": "01_healthy_report",
  "description": "Healthy nightly export: correct file, correct content.",
  "schedule": "daily 02:00",
  "command": [
    "${PYTHON}",
    "${JOB_DIR}/../scripts/export_report.py"
  ],
  "cwd": "${WORKSPACE}/01_healthy_report",
  "timeout_seconds": 30,
  "expected_outcome": "out/report-<RUN_DATE>.json is written during the run with total > 0 and date = RUN_DATE.",
  "checks": [
    {
      "type": "file",
      "name": "today's report written",
      "path": "out/report-${RUN_DATE}.json",
      "fresh": true,
      "json_field": "total",
      "op": "gt",
      "value": 0
    },
    {
      "type": "file",
      "name": "report is for the run date",
      "path": "out/report-${RUN_DATE}.json",
      "json_field": "date",
      "op": "equals",
      "value": "${RUN_DATE}"
    }
  ],
  "demo": {
    "expected_verdict": "OK",
    "cause_keywords": []
  }
}
